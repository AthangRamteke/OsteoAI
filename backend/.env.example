# Copy to backend/.env and fill in. Missing/expired keys are skipped automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
GROK_MODEL=grok-3-mini
# Local backup (Ollama)
OLLAMA_URL=http://localhost:11434
QWEN_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=60
QWEN_TIMEOUT_SECONDS=180

# -------------------------------------------------------------------
# PostgreSQL (local only - never expose this port through a tunnel)
# -------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Leave DATABASE_URL empty to run without persistence; predictions
# still work and are returned with "persisted": false.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/osteoai

# When true, a failed database write makes POST /api/predict return 503
# instead of an unsaved prediction.
DB_REQUIRED=false

DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=5

# -------------------------------------------------------------------
# Accounts
# -------------------------------------------------------------------
# Long random string used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Token lifetime with "Remember me" ticked (hours; 720 = 30 days)
JWT_REMEMBER_HOURS=720
# Token lifetime without "Remember me" (hours)
JWT_SESSION_HOURS=12

# -------------------------------------------------------------------
# Find a Doctor (OpenStreetMap - free, no API key)
# -------------------------------------------------------------------
# Nominatim/Overpass require a User-Agent that identifies the app.
# Add a contact address if you deploy this publicly.
OSM_USER_AGENT=OsteoAI/1.0 (academic project; hospital finder)
